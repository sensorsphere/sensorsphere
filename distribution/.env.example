SENSORSPHERE_ENVIRONMENT=DIT
SENSORSPHERE_PROJECT_TODOS_ENABLED=false
INSTANCE_NAME=SensorSphere

# Authentication policy:
# - DEV defaults to disabled unless SENSORSPHERE_AUTH_ENABLED=true is supplied.
# - TEST* / TST* default to enabled but may be explicitly disabled.
# - other environments default to enabled and cannot be disabled.
# When authentication is enabled, SENSORSPHERE_PUBLIC_URL,
# SENSORSPHERE_AUTH_BOOTSTRAP_ADMIN_EMAIL and complete credentials for every
# provider in SENSORSPHERE_AUTH_PROVIDERS are required.
#
# SENSORSPHERE_AUTH_ENABLED=true
# SENSORSPHERE_PUBLIC_URL=https://dit.example.com
# SENSORSPHERE_AUTH_PROVIDERS=google
# SENSORSPHERE_AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# SENSORSPHERE_GOOGLE_CLIENT_ID=
# SENSORSPHERE_GOOGLE_CLIENT_SECRET=
# SENSORSPHERE_MICROSOFT_CLIENT_ID=
# SENSORSPHERE_MICROSOFT_CLIENT_SECRET=
# SENSORSPHERE_MICROSOFT_TENANT=common
#
# Unauthenticated role switch for DEV, TEST*, and TST*:
# SENSORSPHERE_AUTH_DEV_ROLE_SWITCH_ENABLED=true
# SENSORSPHERE_AUTH_DEV_DEFAULT_ROLE=admin

SENSORSPHERE_IMAGE_REGISTRY=ghcr.io
SENSORSPHERE_IMAGE_NAMESPACE=sensorsphere

POSTGRES_DB=sensorsphere
POSTGRES_USER=sensorsphere
POSTGRES_PASSWORD=CHANGE_ME

DATA_ROOT=./data

# Backup V2 local repository (backup Core module; not started by normal up -d).
# SENSORSPHERE_BACKUP_ROOT=./backups
# SENSORSPHERE_BACKUP_STATE_ROOT=./data/backup-state
# SENSORSPHERE_BACKUP_RETENTION_DAILY=7
# SENSORSPHERE_BACKUP_RETENTION_WEEKLY=4
# SENSORSPHERE_BACKUP_RETENTION_MONTHLY=6
# SENSORSPHERE_BACKUP_WARNING_AGE_HOURS=26
# SENSORSPHERE_BACKUP_CRITICAL_AGE_HOURS=48

# Database Storage & Retention dashboard sampling.
# SENSORSPHERE_DB_STORAGE_SNAPSHOT_INTERVAL_HOURS=6
# SENSORSPHERE_DB_STORAGE_SNAPSHOT_RETENTION_DAYS=90
# Optional byte budgets; leave unset for UNCONFIGURED.
# SENSORSPHERE_DB_STORAGE_WARNING_BYTES=8589934592
# SENSORSPHERE_DB_STORAGE_CRITICAL_BYTES=10737418240

MQTT_BIND_ADDRESS=0.0.0.0
MQTT_PORT=1883
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080

TIMESCALEDB_IMAGE_TAG=2.21.3-pg17
MOSQUITTO_IMAGE_TAG=2
