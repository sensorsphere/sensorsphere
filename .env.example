# =============================================================================
# SensorSphere environment configuration
# =============================================================================


# -----------------------------------------------------------------------------
# Docker Compose instance
# -----------------------------------------------------------------------------

# Docker Compose project name.
#
# This name is used to isolate Docker containers, networks and other
# Compose resources.
#
# Each SensorSphere instance running on the same Docker host MUST use
# a different project name.
#
# Default:
# COMPOSE_PROJECT_NAME=sensorsphere


# SensorSphere instance display name.
#
# This value is exposed by the backend runtime configuration API and is used
# by the frontend in the application header and browser tab title.
#
# Default:
# INSTANCE_NAME=SensorSphere
# Optional CSS RGB/hex color for the instance name in the header, e.g. #123456
# INSTANCE_NAME_COLOR=#123456


# SensorSphere deployment environment. This value belongs to the whole
# SensorSphere installation and is inherited by every Supervisor Agent.
# Typical explicit values are DIT, IAT and PROD. DEFAULT preserves legacy
# installations and is not treated as an alias for PROD.
#
# Default:
# SENSORSPHERE_ENVIRONMENT=DEFAULT


# -----------------------------------------------------------------------------
# SensorSphere Stack Release / application images
# -----------------------------------------------------------------------------

# Stack Release selected for this installation.
# The Stack Release manifest defines the validated component combination.
#
# Default:
# SENSORSPHERE_STACK_VERSION=2026.09.25.3
#
# Container registry and namespace used by SensorSphere images.
# SENSORSPHERE_IMAGE_REGISTRY=ghcr.io
# SENSORSPHERE_IMAGE_NAMESPACE=sensorsphere
#
# Component versions selected by the Stack Release.
# SENSORSPHERE_API_VERSION=1.44.0
# SENSORSPHERE_FRONTEND_VERSION=1.83.0
# SENSORSPHERE_INGESTION_VERSION=1.0.0
# SENSORSPHERE_NGINX_VERSION=1.0.0
# SENSORSPHERE_MIGRATIONS_VERSION=72


# -----------------------------------------------------------------------------
# Persistent data
# -----------------------------------------------------------------------------

# Root directory containing all persistent SensorSphere runtime data.
#
# Directory structure:
#
#   DATA_ROOT/
#   ├── app/
#   ├── mosquitto/
#   │   ├── data/
#   │   └── log/
#   └── timescaledb/
#
# Each SensorSphere instance running from the same repository MUST use
# a different DATA_ROOT.
#
# Default:
# DATA_ROOT=./data
#
# Examples:
#
# DATA_ROOT=./data-dev
# DATA_ROOT=./data-test


# -----------------------------------------------------------------------------
# PostgreSQL / TimescaleDB
# -----------------------------------------------------------------------------

# PostgreSQL database name.
#
# Default:
# POSTGRES_DB=sensorsphere


# PostgreSQL user.
#
# Default:
# POSTGRES_USER=sensorsphere


# PostgreSQL password.
#
# REQUIRED.
# There is deliberately no default password.
#
# Example:
# POSTGRES_PASSWORD=change-me


# TimescaleDB Docker image tag.
#
# Default:
# TIMESCALEDB_IMAGE_TAG=2.21.3-pg17


# Database healthcheck interval.
#
# Default:
# DB_HEALTHCHECK_INTERVAL=10s


# Database healthcheck timeout.
#
# Default:
# DB_HEALTHCHECK_TIMEOUT=5s


# Number of database healthcheck retries.
#
# Default:
# DB_HEALTHCHECK_RETRIES=10


# -----------------------------------------------------------------------------
# MQTT / Mosquitto
# -----------------------------------------------------------------------------

# Host address on which the MQTT port is published.
#
# 0.0.0.0     = all IPv4 interfaces
# 127.0.0.1   = localhost only
# <IP>        = one specific host interface
#
# Default:
# MQTT_BIND_ADDRESS=0.0.0.0


# MQTT port published on the Docker host.
#
# Each SensorSphere instance on the same host MUST use a different port.
#
# Default:
# MQTT_PORT=1883


# MQTT URL used internally by the ingestion service.
#
# Normally this should not be changed.
#
# Default:
# MQTT_INTERNAL_URL=mqtt://mosquitto:1883


# The ingestion service is pinned by docker-compose to the gateway-qualified
# SensorSphere MQTT path:
# sensors/ble_gateway/+/sensor/+/state
#
# Metric Routing is also pinned to active mode. Legacy MQTT topics are no
# longer a productive input path.


# Mosquitto Docker image tag.
#
# Default:
# MOSQUITTO_IMAGE_TAG=2


# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------

# Internal API listening port.
#
# This is an internal Docker port and normally does not need to be changed.
#
# Default:
# API_PORT=3000


# History configuration path inside the API container.
#
# Default:
# HISTORY_CONFIG_PATH=/app/data/history-config.json


# -----------------------------------------------------------------------------
# Web / nginx
# -----------------------------------------------------------------------------

# Host address on which the web interface is published.
#
# Default:
# WEB_BIND_ADDRESS=0.0.0.0


# Web port published on the Docker host.
#
# Each SensorSphere instance on the same host MUST use a different port.
#
# Default:
# WEB_PORT=8080


# nginx base image tag used when building the SensorSphere nginx image in DEV.
#
# Default:
# NGINX_BASE_IMAGE_TAG=1.28-alpine


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Application log level.
#
# Typical values:
#   trace
#   debug
#   info
#   warn
#   error
#
# Default:
# LOG_LEVEL=info


# -----------------------------------------------------------------------------
# Backup
# -----------------------------------------------------------------------------

# Backup root directory.
#
# Default:
# BACKUP_ROOT=/var/backups/sensorsphere


# Number of daily backups kept.
#
# Default:
# RETENTION_DAILY=7


# Number of weekly backups kept.
#
# Default:
# RETENTION_WEEKLY=4


# Number of monthly backups kept.
#
# Default:
# RETENTION_MONTHLY=6


# Helper Docker image used by backup tooling.
#
# Default:
# PROJECT_BACKUP_IMAGE=eclipse-mosquitto:2